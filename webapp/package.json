{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite -c app/vite.config.js",
    "dev:admin": "vite -c admin/vite.config.js",
    "watch": "vite build -c app/vite.config.js --watch",
    "watch:admin": "vite build -c admin/vite.config.js --watch",
    "build": "npm run build:app && npm run build:admin",
    "build:app": "vite build -c app/vite.config.js",
    "build:admin": "vite build -c admin/vite.config.js"
  },
  "dependencies": {
    "vite": "^6.4.1"
  }
}
